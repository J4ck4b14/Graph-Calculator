<Window x:Class="GraphCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graph Calculator"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        Background="#FFF4F5F7"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD5D8DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD5D8DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#FFE1E3E7" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Graph Calculator" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Scroll to zoom · drag to pan"
                           Foreground="#FF6B7280"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="250" MaxWidth="560"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#FFE1E3E7" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="Expressions" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarButton}"
                                Content="+ Expression"
                                Click="AddExpressionButton_Click"/>
                    </DockPanel>

                    <ListBox x:Name="ExpressionsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Expressions}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFAFAFB" BorderBrush="#FFE4E6EA" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="10"
                                                 Height="10"
                                                 Fill="{Binding Color}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 Padding="6,5"
                                                 BorderBrush="#FFD6D9DE"
                                                 GotKeyboardFocus="ExpressionBox_GotKeyboardFocus"
                                                 KeyDown="ExpressionBox_KeyDown"/>

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="Show or hide this expression"/>

                                        <Button Grid.Column="3"
                                                Style="{StaticResource SmallIconButton}"
                                                Content="×"
                                                ToolTip="Remove expression"
                                                Click="RemoveExpressionButton_Click"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding StatusText}"
                                                   Foreground="#FF6B7280"
                                                   FontSize="12"
                                                   Margin="6,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Expander Grid.Row="2" Header="Keypad" Margin="2,10,2,0" IsExpanded="False">
                        <UniformGrid Columns="6" Margin="0,8,0,0">
                            <Button Style="{StaticResource KeyButton}" Content="7" Tag="7" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="8" Tag="8" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="9" Tag="9" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="÷" Tag="/" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="sin" Tag="sin(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="cos" Tag="cos(" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="4" Tag="4" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="5" Tag="5" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="6" Tag="6" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="×" Tag="*" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="tan" Tag="tan(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="√" Tag="sqrt(" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="1" Tag="1" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="2" Tag="2" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="3" Tag="3" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="−" Tag="-" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="(" Tag="(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content=")" Tag=")" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="0" Tag="0" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="." Tag="." Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="," Tag="," Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="+" Tag="+" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="^" Tag="^" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="π" Tag="π" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="log" Tag="log(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="ln" Tag="ln(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="exp" Tag="exp(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="pow" Tag="pow(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="abs" Tag="abs(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="⌫" Click="BackspaceButton_Click"/>
                        </UniformGrid>
                    </Expander>

                    <TextBlock Grid.Row="3"
                               Margin="2,10,2,0"
                               Text="Examples: 2x, sin(x), (x+1)(x-1), y = sqrt(x), 1e-6"
                               Foreground="#FF8A9099"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <Border Grid.Column="2" Background="White" BorderBrush="#FFE1E3E7" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,8">
                        <TextBlock Text="Graph" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="GraphStatusText"
                                       Foreground="#FF6B7280"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Fit graph" Click="FitGraphButton_Click"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Reset" Click="ResetViewButton_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="GraphSurface"
                          Grid.Row="1"
                          Background="#FFFBFCFE"
                          ClipToBounds="True"
                          SizeChanged="GraphSurface_SizeChanged">
                        <Canvas x:Name="PlotCanvas"
                                Background="Transparent"
                                MouseMove="PlotCanvas_MouseMove"
                                MouseLeave="PlotCanvas_MouseLeave"
                                MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                                MouseWheel="PlotCanvas_MouseWheel"/>

                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                            <Line x:Name="CrosshairVertical"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>
                            <Line x:Name="CrosshairHorizontal"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>

                            <Border x:Name="HoverPanel"
                                    Visibility="Collapsed"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#FFD0D4DA"
                                    BorderThickness="1"
                                    Padding="8"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock x:Name="HoverXText" FontWeight="SemiBold"/>
                                    <ItemsControl x:Name="HoverValuesList" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE1E3E7" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="ViewRangeText" Foreground="#FF6B7280"/>
                <TextBlock DockPanel.Dock="Right" Foreground="#FF8A9099" Text="Enter refreshes immediately · Esc clears the active expression"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
