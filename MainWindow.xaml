<Window x:Class="GraphCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graph Calculator"
        Icon="Assets/CalcLogo.ico"
        Width="1180"
        Height="760"
        MinWidth="760"
        MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ToolTipService.InitialShowDelay="250"
        ToolTipService.ShowDuration="15000"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF15181D"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF1D2128"/>
        <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#FF242933"/>
        <SolidColorBrush x:Key="GraphBackgroundBrush" Color="#FF171B21"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF20252D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FFAAB2BF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FF343B46"/>
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F21D2128"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#FF2B313B"/>
        <SolidColorBrush x:Key="AxisBrush" Color="#FF7F8997"/>
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FF2C333E"/>
        <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#FF35445F"/>
        <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FF1A1E24"/>
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF707987"/>

        <!-- Override the system brushes used by the stock WPF control templates.
             This keeps ComboBox/TabItem popup chrome from reverting to white in dark mode. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF20252D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF1D2128"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF2F4F7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF35445F"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF707987"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF1D2128"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF2F4F7"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Stock WPF ComboBox/ComboBoxItem templates pull system colours in several
             places. Own the templates so theme colours are deterministic in dark mode. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>

                            <!-- Transparent hit target. Its own template prevents the OS
                                 ToggleButton chrome from leaking back into the theme. -->
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="SelectionPresenter"
                                              Margin="8,1,27,1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <TextBlock x:Name="DropDownGlyph"
                                       Text="▾"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,1"
                                       IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border x:Name="PopupBorder"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="1">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AxisBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                                <Setter TargetName="DropDownGlyph" Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Panel.ZIndex="1"
                                      Background="Transparent"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    Margin="0,3,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AxisBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GraphBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource GraphBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="KeyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/CalcLogo-64.png"
                           Width="30"
                           Height="30"
                           Margin="0,0,9,0"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                    <TextBlock Text="Graph Calculator"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="WorkspaceModeComboBox" Width="142" Height="30" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="WorkspaceModeComboBox_SelectionChanged" ToolTip="Workspace">
                        <ComboBoxItem Content="Function Lab"/>
                        <ComboBoxItem Content="Curve Designer"/>
                        <ComboBoxItem Content="Economy Designer"/>
                        <ComboBoxItem Content="HLSL Lab"/>
                    </ComboBox>
                    <Button Style="{StaticResource ToolbarButton}" Content="Load" Click="LoadWorkspaceButton_Click" ToolTip="Open workspace (Ctrl+O)"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="Save" Click="SaveWorkspaceButton_Click" ToolTip="Save workspace (Ctrl+S) · Shift+click for Save As"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="Undo" Click="UndoWorkspaceButton_Click" ToolTip="Undo the last grouped edit"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="Redo" Click="RedoWorkspaceButton_Click" ToolTip="Redo the last undone edit"/>
                    <TextBlock x:Name="ProjectDirtyText" Text="Saved" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                    <Button x:Name="RecoveryButton" Style="{StaticResource ToolbarButton}" Content="Recovery" Visibility="Collapsed" Click="RecoveryButton_Click" ToolTip="Restore the latest autosaved recovery state"/>
                    <ComboBox x:Name="RecentWorkspaceComboBox" Width="115" Height="30" Margin="6,0,0,0" ToolTip="Recent workspaces"/>
                    <Button Style="{StaticResource ToolbarButton}" Content="Open" Click="OpenRecentWorkspaceButton_Click" ToolTip="Open selected recent workspace"/>
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource ToolbarButton}" Width="36" Content="☀" Click="ThemeToggleButton_Click" ToolTip="Switch to light theme"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="385" MinWidth="285" MaxWidth="580"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="Expressions" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarButton}"
                                Content="+ Expression"
                                Click="AddExpressionButton_Click"/>
                    </DockPanel>

                    <ListBox x:Name="ExpressionsListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Expressions}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="10"
                                                 Height="10"
                                                 Fill="{Binding Color}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="16"
                                                 Padding="6,5"
                                                 MinHeight="38"
                                                 MaxHeight="150"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 SpellCheck.IsEnabled="False"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 GotKeyboardFocus="ExpressionBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="ExpressionBox_LostKeyboardFocus"
                                                 KeyDown="ExpressionBox_KeyDown"
                                                 ToolTip="Multiline maths is supported. Enter adds a line · Ctrl+Enter refreshes · Ctrl+Space opens function suggestions."/>

                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="Show or hide this expression"/>

                                        <Button Grid.Column="3"
                                                Style="{StaticResource SmallIconButton}"
                                                Content="×"
                                                ToolTip="Remove expression"
                                                Click="RemoveExpressionButton_Click"/>

                                        <Expander Grid.Row="1"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="3"
                                                  Header="Domain / range"
                                                  Margin="6,5,0,0"
                                                  IsExpanded="False"
                                                  FontSize="11"
                                                  Foreground="{DynamicResource MutedTextBrush}">
                                            <WrapPanel Margin="0,4,0,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DomainPrimaryLabel}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBox Width="50" Padding="3,1" FontSize="11"
                                                         ToolTip="Minimum domain value. Leave blank for no restriction; expressions such as -pi are allowed."
                                                         Text="{Binding DomainMinX, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                                <TextBox Width="50" Padding="3,1" FontSize="11" Margin="0,0,8,0"
                                                         ToolTip="Maximum domain value. Leave blank for no restriction; expressions such as 2*pi are allowed."
                                                         Text="{Binding DomainMaxX, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding DomainYVisibility}">
                                                    <TextBlock Text="{Binding DomainSecondaryLabel}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <TextBox Width="50" Padding="3,1" FontSize="11"
                                                             ToolTip="Minimum secondary-domain value. Leave blank for no restriction."
                                                             Text="{Binding DomainMinY, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                                                    <TextBox Width="50" Padding="3,1" FontSize="11"
                                                             ToolTip="Maximum secondary-domain value. Leave blank for no restriction."
                                                             Text="{Binding DomainMaxY, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </Expander>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding StatusText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Margin="6,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Expander Grid.Row="2" Header="Preset library" Margin="2,10,2,0" IsExpanded="False">
                        <StackPanel Margin="0,7,0,0">
                            <ComboBox x:Name="PresetComboBox"
                                      SelectionChanged="PresetComboBox_SelectionChanged"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="PresetDescriptionText"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="2,6,2,6"
                                       TextWrapping="Wrap"/>
                            <Button Content="Add preset"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    ToolTip="Adds the preset without removing the expressions already in the workspace"
                                    Click="LoadPresetButton_Click"/>
                            <Separator Margin="0,9,0,7"/>
                            <TextBlock Text="Shared project assets" FontWeight="SemiBold"/>
                            <TextBlock Text="Publish a curve/function once, then call AssetName(x) from Function Lab or Economy formulas." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,5"/>
                            <WrapPanel><TextBox x:Name="SharedAssetNameTextBox" Width="110" Text="MyCurve" Padding="3,2"/><Button Content="Publish function" Padding="6,2" Margin="4,0,0,0" Click="PublishExpressionAssetButton_Click"/><Button Content="Publish curve" Padding="6,2" Margin="4,0,0,0" Click="PublishCurveAssetButton_Click"/></WrapPanel>
                            <ListBox x:Name="SharedAssetsListBox" Height="70" Margin="0,5,0,0"/>
                            <WrapPanel Margin="0,4,0,0"><Button Content="Insert call" Padding="6,2" Click="SharedAssetInsertButton_Click"/><Button Content="Delete" Padding="6,2" Margin="4,0,0,0" Click="SharedAssetDeleteButton_Click"/><Button Content="Import CSV table" Padding="6,2" Margin="4,0,0,0" Click="ImportTableButton_Click"/></WrapPanel>
                            <ListBox x:Name="ImportedTablesListBox" Height="42" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ParametersExpander"
                              Grid.Row="3"
                              Header="Parameters"
                              Margin="2,10,2,0"
                              IsExpanded="True"
                              Visibility="Collapsed">
                        <StackPanel Margin="0,7,0,0">
                            <TextBlock Text="Named identifiers that are not plot axes or t/time become live parameters. Slider limits are also animation points A and B."
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,5"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,0,0,7">
                                <Button Content="Capture A" Padding="7,3" Click="CaptureParameterStateAButton_Click"/>
                                <Button Content="Capture B" Padding="7,3" Margin="5,0,0,0" Click="CaptureParameterStateBButton_Click"/>
                                <TextBlock Text="Blend" Margin="9,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <Slider x:Name="ParameterStateBlendSlider" Width="105" Minimum="0" Maximum="1" ValueChanged="ParameterStateBlendSlider_ValueChanged"/>
                                <TextBlock x:Name="ParameterStateBlendText" Text="0%" Width="34" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <ItemsControl x:Name="ParametersItemsControl" ItemsSource="{Binding Parameters}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,7,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,4,0,6"
                                                Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="58"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         FontWeight="SemiBold"
                                                         VerticalAlignment="Center"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="1"
                                                         ToolTip="{Binding Name}"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Minimum, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Padding="3,2"
                                                         ToolTip="A / slider minimum"
                                                         HorizontalContentAlignment="Right"/>
                                                <Slider Grid.Column="2"
                                                        Minimum="{Binding Minimum}"
                                                        Maximum="{Binding Maximum}"
                                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Margin="6,0"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding Maximum, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Padding="3,2"
                                                         ToolTip="B / slider maximum"
                                                         HorizontalContentAlignment="Right"/>
                                                <TextBox Grid.Column="4"
                                                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Padding="4,2"
                                                         Margin="5,0,0,0"
                                                         ToolTip="Current value"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"/>

                                                <WrapPanel Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="5"
                                                           Margin="0,5,0,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBox Width="55" Margin="3,0,6,0" Padding="3,1" FontSize="10" Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Text="Unit" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBox Width="38" Margin="3,0,6,0" Padding="3,1" FontSize="10" Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                    <CheckBox Content="Lock" IsChecked="{Binding IsLocked, Mode=TwoWay}" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Locked parameters ignore animation and A/B blending"/>
                                                    <ToggleButton Content="Auto"
                                                                  IsChecked="{Binding IsAnimating, Mode=TwoWay}"
                                                                  MinWidth="45"
                                                                  Padding="5,2"
                                                                  ToolTip="Animate this parameter from A to B"/>
                                                    <TextBlock Text="Speed"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="8,0,4,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Width="46"
                                                             Text="{Binding AnimationSpeed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Padding="3,2"
                                                             HorizontalContentAlignment="Right"
                                                             ToolTip="Parameter units per second"/>
                                                    <TextBlock Text="/s"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="3,0,7,0"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox Width="88"
                                                              SelectedValue="{Binding AnimationMode, Mode=TwoWay}"
                                                              SelectedValuePath="Content"
                                                              ToolTip="Animation behavior at point B">
                                                        <ComboBoxItem Content="Loop"/>
                                                        <ComboBoxItem Content="Ping-pong"/>
                                                        <ComboBoxItem Content="Once"/>
                                                    </ComboBox>
                                                    <Button Content="↺"
                                                            Width="28"
                                                            Margin="5,0,0,0"
                                                            Padding="2"
                                                            Click="ResetParameterAnimationButton_Click"
                                                            ToolTip="Return to point A"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Grid.Row="4" Header="Keypad" Margin="2,10,2,0" IsExpanded="False">
                        <UniformGrid Columns="6" Margin="0,8,0,0">
                            <Button Style="{StaticResource KeyButton}" Content="7" Tag="7" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="8" Tag="8" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="9" Tag="9" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="÷" Tag="/" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="sin" Tag="sin(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="cos" Tag="cos(" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="4" Tag="4" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="5" Tag="5" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="6" Tag="6" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="×" Tag="*" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="tan" Tag="tan(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="√" Tag="sqrt(" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="1" Tag="1" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="2" Tag="2" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="3" Tag="3" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="−" Tag="-" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="(" Tag="(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content=")" Tag=")" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="0" Tag="0" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="." Tag="." Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="," Tag="," Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="+" Tag="+" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="^" Tag="^" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="π" Tag="π" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="log" Tag="log(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="ln" Tag="ln(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="exp" Tag="exp(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="pow" Tag="pow(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="abs" Tag="abs(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="⌫" Click="BackspaceButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="x" Tag="x" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="y" Tag="y" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="e" Tag="e" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="max" Tag="max(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="min" Tag="min(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="floor" Tag="floor(" Click="KeypadButton_Click"/>

                            <Button Style="{StaticResource KeyButton}" Content="clamp" Tag="clamp(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="lerp" Tag="lerp(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="smooth" Tag="smoothstep(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="frac" Tag="frac(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="sat" Tag="saturate(" Click="KeypadButton_Click"/>
                            <Button Style="{StaticResource KeyButton}" Content="mod" Tag="mod(" Click="KeypadButton_Click"/>
                        </UniformGrid>
                    </Expander>

                    <StackPanel Grid.Row="5" Margin="2,8,2,0">
                        <TextBlock x:Name="ExamplesText"
                                   Text="Examples: 2x · r(u,v)=(...) · multiline recurrence · dy/dt=-y · Lorenz system · HLSL Lab in the toolbar"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <Expander Header="Math reference" Margin="0,7,0,0" IsExpanded="False">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                <StackPanel Margin="8">
                                    <DockPanel>
                                        <TextBlock Text="Advanced maths" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="Open HLSL Lab" Padding="7,2" Click="OpenHlslLabButton_Click" ToolTip="Open the dedicated shader editor and searchable HLSL dictionary"/>
                                    </DockPanel>
                                    <TextBlock Text="Complex algebra" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                    <TextBlock Text="i is √−1. Write 3+4i directly, use z as x+iy in complex maps, or construct values with complex(a,b). re/real, im/imag, abs, arg/phase, conj, cis and polar are complex-aware." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="complexmap(f(z)=(z^3-1)/(z^3+1))" FontFamily="Consolas" FontSize="11"/>
                                    <TextBlock Text="Multiline maths" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock Text="Enter adds a line inside one expression card. Newlines and semicolons separate top-level statements, while line breaks inside (...) stay part of the same vector/function. Ctrl+Enter forces an immediate refresh." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="Calculus &amp; series" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock Text="derivative(expr,x) · integral(expr,x,a,b) · primitive(expr,x,origin) · sum(expr,k,a,b) · product(expr,k,a,b)" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="Recurrence" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock Text="Write each recurrence statement on its own line: the update rule, initial value, N, and optional radius. Semicolons still work. z_{n+1}/z_n notation is accepted too." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="z[n+1]=z[n]^2+c  ·  z[0]=0  ·  N=80  ·  radius=2" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                    <TextBlock Text="Differential equations &amp; dynamics" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock Text="Use dy/dt=-y plus y(0)=1 for a 1D ODE. Two equations become a 2D phase trajectory; three become a 3D trajectory. x'=... shorthand works too. name=value lines are local constants; undeclared symbols become live parameters. Integration uses RK4." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="When a system is active, a contextual Dynamics tab appears beside the graph tools. Its compact readout shows the current state and ↑/↓ trend, Time series shows every state against t, and Table exposes sampled states and derivatives. Hover the ⓘ marker for a short explanation of the active phase/state plot." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Text="dx/dt=10*(y-x) · dy/dt=x*(28-z)-y · dz/dt=x*y-(8/3)*z · x(0)=1 · y(0)=1 · z(0)=1" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                                    <TextBlock Text="Procedural profiles" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock Text="superformula(angle,m,n1,n2,n3,a,b) returns a radius. Use it inside r(t)=(radius*cos(t),radius*sin(t)); the Superformula flower preset is ready to edit." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,5"/>
                                    <TextBlock Text="Dedicated fractal helpers remain available when you want the fast path: mandelbrot(...), mandelbrotsmooth(...), julia(...), juliasmooth(...)." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>

                    <Grid x:Name="CurveDesignerLeftPanel" Grid.RowSpan="6" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Curve Designer" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Author a response curve by placing keys. The generated result is a piecewise cubic Hermite function, so it stays useful outside this editor." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <TextBlock Text="New key" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBox x:Name="CurveNewXTextBox" Width="55" Text="0" Margin="6,0,3,0" Padding="4,2" ToolTip="Exact X"/>
                                <TextBox x:Name="CurveNewYTextBox" Width="55" Text="0" Margin="0,0,5,0" Padding="4,2" ToolTip="Exact Y"/>
                                <Button Content="Add" Padding="7,2" Click="CurveAddExactButton_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,7,0,0">
                                <CheckBox x:Name="CurveSnapCheckBox" Content="Snap" VerticalAlignment="Center"/>
                                <TextBox x:Name="CurveSnapStepTextBox" Width="48" Text="0.1" Margin="5,0,8,0" Padding="3,1" ToolTip="Snap spacing"/>
                                <Button Content="Delete key" Padding="7,2" Click="CurveDeleteKeyButton_Click"/>
                                <Button Content="Clear" Padding="7,2" Margin="5,0,0,0" Click="CurveClearButton_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,7,0,0">
                                <TextBlock Text="Channel" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <ComboBox x:Name="CurveChannelsComboBox" Width="110" Margin="5,0" SelectionChanged="CurveChannelsComboBox_SelectionChanged"/>
                                <Button Content="+" Width="28" Click="CurveAddChannelButton_Click"/><Button Content="−" Width="28" Margin="3,0,0,0" Click="CurveDeleteChannelButton_Click"/>
                                <TextBox x:Name="CurveChannelNameTextBox" Width="78" Margin="5,0,0,0" Padding="3,1" Text="Value" LostKeyboardFocus="CurveChannelNameTextBox_LostKeyboardFocus" ToolTip="Rename active channel"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Auto tension" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <Slider x:Name="CurveTensionSlider" Width="145" Minimum="0" Maximum="1" Value="0" Margin="6,0" ValueChanged="CurveTensionSlider_ValueChanged"/>
                                <TextBlock x:Name="CurveTensionText" Text="0.00" Width="38" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="Outside the authored range" FontWeight="SemiBold" FontSize="11" Margin="0,9,0,3"/>
                            <WrapPanel>
                                <TextBlock Text="Before" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <ComboBox x:Name="CurveBeforeModeComboBox" Width="106" Margin="5,0,9,0" SelectionChanged="CurveWrapModeComboBox_SelectionChanged" ToolTip="What the curve does before its first key">
                                    <ComboBoxItem Content="Clamp" Tag="Clamp"/>
                                    <ComboBoxItem Content="Continue (tangent)" Tag="Continue"/>
                                    <ComboBoxItem Content="Repeat" Tag="Repeat"/>
                                    <ComboBoxItem Content="Ping-pong" Tag="PingPong"/>
                                    <ComboBoxItem Content="Invert repeat" Tag="Invert"/>
                                    <ComboBoxItem Content="Repeat + offset" Tag="RepeatOffset"/>
                                </ComboBox>
                                <TextBlock Text="After" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                <ComboBox x:Name="CurveAfterModeComboBox" Width="106" Margin="5,0,0,0" SelectionChanged="CurveWrapModeComboBox_SelectionChanged" ToolTip="What the curve does after its last key">
                                    <ComboBoxItem Content="Clamp" Tag="Clamp"/>
                                    <ComboBoxItem Content="Continue (tangent)" Tag="Continue"/>
                                    <ComboBoxItem Content="Repeat" Tag="Repeat"/>
                                    <ComboBoxItem Content="Ping-pong" Tag="PingPong"/>
                                    <ComboBoxItem Content="Invert repeat" Tag="Invert"/>
                                    <ComboBoxItem Content="Repeat + offset" Tag="RepeatOffset"/>
                                </ComboBox>
                            </WrapPanel>
                            <TextBlock Text="Clamp holds the endpoint. Continue follows its tangent. Repeat loops. Ping-pong reverses direction. Invert alternates the curve vertically. Repeat + offset repeats while preserving the net rise/fall." Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <DataGrid x:Name="CurveKeysDataGrid" Grid.Row="2" Margin="0,10,0,8" ItemsSource="{Binding CurveKeys}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="CurveKeysDataGrid_SelectionChanged" CellEditEnding="CurveKeysDataGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="X" Binding="{Binding X, UpdateSourceTrigger=LostFocus}" Width="52"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, UpdateSourceTrigger=LostFocus}" Width="52"/>
                                <DataGridTemplateColumn Header="Tangent" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding TangentMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" SelectionChanged="CurveTangentModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Auto"/>
                                                <ComboBoxItem Content="Linear"/>
                                                <ComboBoxItem Content="Flat"/>
                                                <ComboBoxItem Content="Manual"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="In" Binding="{Binding InTangent, UpdateSourceTrigger=LostFocus}" Width="48"/>
                                <DataGridTextColumn Header="Out" Binding="{Binding OutTangent, UpdateSourceTrigger=LostFocus}" Width="48"/>
                                <DataGridTextColumn Header="In W" Binding="{Binding InWeight, UpdateSourceTrigger=LostFocus}" Width="44"/>
                                <DataGridTextColumn Header="Out W" Binding="{Binding OutWeight, UpdateSourceTrigger=LostFocus}" Width="48"/>
                                <DataGridCheckBoxColumn Header="Link" Binding="{Binding LinkedTangents}" Width="42"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Curve definition" FontWeight="SemiBold"/>
                            <TextBox x:Name="CurveDefinitionTextBox" Margin="0,4,0,0" Padding="5,3" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="10.5"/>
                            <Expander Header="Exact expanded formula" Margin="0,5,0,0" ToolTip="The literal piecewise equation used when sending the exact spline to Function Lab">
                                <TextBox x:Name="CurveFormulaTextBox" Height="86" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
                            </Expander>
                            <Expander Header="Similar analytic functions" IsExpanded="True" Margin="0,5,0,0">
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="Orange dashed = selected approximation. Error is RMSE relative to the curve's Y range; suggestions fit the authored key range only." Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <ListBox x:Name="CurveSuggestionsListBox" ItemsSource="{Binding CurveSuggestions}" Height="125" SelectionChanged="CurveSuggestionsListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ErrorText}" Foreground="#FFB45309" FontSize="10" Margin="8,0,0,0"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Formula}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Formula}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Add suggestion to Function Lab" Padding="7,2" Click="CurveUseSuggestionButton_Click"/>
                                        <Button Content="Copy suggestion" Padding="7,2" Margin="5,0,0,0" Click="CurveCopySuggestionButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button Content="Copy exact formula" Padding="8,3" Click="CurveCopyFormulaButton_Click"/>
                            <Button Content="Add exact spline to Function Lab" Padding="8,3" Margin="5,0,0,0" Click="CurveSendToFunctionLabButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <ScrollViewer x:Name="EconomyDesignerLeftPanel" Grid.RowSpan="6" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,4">
                            <TextBlock Text="Economy Designer" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Model typed resources, stochastic flows, schedules and player segments. Everything stays local and the economy can be shared as one portable project file." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Expander Header="Quick guide — start here" IsExpanded="True" Margin="0,0,0,8">
                                <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7">
                                    <StackPanel>
                                        <TextBlock Text="1. Add a Source/Event, a Pool, and a Sink." FontSize="10.5"/>
                                        <TextBlock Text="2. Turn on Connect; click the origin node, then the destination." FontSize="10.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="3. Select each flow and set its Rate. Unknown names become sliders." FontSize="10.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="4. Press ▶. Flow colour tells you the resource; moving dots show actual traffic." FontSize="10.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="5. Use Predictions for many runs and Balance search for target-driven tuning." FontSize="10.5" Margin="0,2,0,0"/>
                                        <TextBlock Text="The README contains a beginner walkthrough and the full technical model." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <GroupBox Header="Economy project">
                                <StackPanel Margin="6">
                                    <TextBox x:Name="EconomyProjectNameTextBox" Text="Economy model" Padding="4,2" ToolTip="Project name stored in the .gceconomy file"/>
                                    <TextBox x:Name="EconomyProjectDescriptionTextBox" Margin="0,5,0,0" Height="42" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="4,2" ToolTip="Optional notes for whoever opens this project later"/>
                                    <WrapPanel Margin="0,5,0,0">
                                        <Button Content="Save economy…" Padding="7,3" Click="EconomySaveProjectButton_Click"/>
                                        <Button Content="Open economy…" Padding="7,3" Margin="5,0,0,0" Click="EconomyOpenProjectButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Diagram" Margin="0,8,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="Core" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,3"/>
                                    <WrapPanel>
                                        <Button Content="+ Source" Padding="7,3" Click="EconomyAddSourceButton_Click" ToolTip="Continuous or formula-driven resource faucet"/>
                                        <Button Content="+ Pool" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddPoolButton_Click" ToolTip="Stores a resource with an initial amount and capacity"/>
                                        <Button Content="+ Converter" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddConverterButton_Click" ToolTip="Processing/storage stage used for cross-resource conversion"/>
                                        <Button Content="+ Action" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddActionButton_Click" ToolTip="Explicit player/designer-triggered action"/>
                                        <Button Content="+ Sink" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddSinkButton_Click" ToolTip="Consumes a resource"/>
                                    </WrapPanel>
                                    <TextBlock Text="Logic / time" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,3"/>
                                    <WrapPanel>
                                        <Button Content="+ Event" Padding="7,3" Click="EconomyAddEventButton_Click" ToolTip="Source-like node intended for scheduled or chance-based events"/>
                                        <Button Content="+ Gate" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddGateButton_Click" ToolTip="Routing buffer; use outgoing flow conditions/chances to branch resources"/>
                                        <Button Content="+ Queue" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddQueueButton_Click" ToolTip="Storage stage intended for paced or delayed release"/>
                                        <Button Content="+ Register" Padding="7,3" Margin="4,0,0,0" Click="EconomyAddRegisterButton_Click" ToolTip="Numeric state pool for counters, reputation, pressure or abstract values"/>
                                        <ToggleButton x:Name="EconomyConnectToggle" Content="Connect" Padding="7,3" Margin="4,0,0,0" Checked="EconomyConnectToggle_Changed" Unchecked="EconomyConnectToggle_Changed"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,7,0,0">
                                        <ComboBox x:Name="EconomyExampleComboBox" Width="215" SelectedIndex="0">
                                            <ComboBoxItem Content="Faucet / sink balance"/>
                                            <ComboBoxItem Content="Inflation pressure"/>
                                            <ComboBoxItem Content="Two-currency live service"/>
                                            <ComboBoxItem Content="Random loot loop"/>
                                            <ComboBoxItem Content="Seasonal event economy"/>
                                            <ComboBoxItem Content="Crafting conversion chain"/>
                                            <ComboBoxItem Content="Branching reward router"/>
                                        </ComboBox>
                                        <Button Content="Load example" Padding="7,2" Margin="5,0,0,0" Click="LoadEconomyExampleButton_Click"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="Group" Padding="6,2" Click="EconomyGroupSelectedButton_Click" ToolTip="Ctrl+click nodes, then group"/>
                                        <Button Content="Copy" Padding="6,2" Margin="3,0,0,0" Click="EconomyCopySelectedButton_Click" ToolTip="Ctrl+C"/>
                                        <Button Content="Paste" Padding="6,2" Margin="3,0,0,0" Click="EconomyPasteSelectedButton_Click" ToolTip="Ctrl+V"/>
                                        <Button Content="Select all" Padding="6,2" Margin="3,0,0,0" Click="EconomySelectAllButton_Click"/>
                                        <Button Content="Duplicate" Padding="6,2" Margin="3,0,0,0" Click="EconomyDuplicateSelectedButton_Click"/>
                                        <Button Content="Align H" Padding="6,2" Margin="3,0,0,0" Click="EconomyAlignHorizontalButton_Click"/>
                                        <Button Content="Align V" Padding="6,2" Margin="3,0,0,0" Click="EconomyAlignVerticalButton_Click"/>
                                        <Button Content="Distribute" Padding="6,2" Margin="3,0,0,0" Click="EconomyDistributeButton_Click"/>
                                        <TextBox x:Name="EconomyGridStepTextBox" Width="38" Text="20" Margin="5,0,0,0" Padding="2" ToolTip="Grid step"/><Button Content="Snap" Padding="6,2" Margin="3,0,0,0" Click="EconomySnapSelectedButton_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="EconomyConnectHintText" Text="Drag nodes to arrange them. Ctrl+click for multi-select." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Selected node" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Name" VerticalAlignment="Center"/><TextBox x:Name="EconomyNodeNameTextBox" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyNodeInspector_LostKeyboardFocus"/>
                                        <TextBlock Grid.Row="1" Text="Resource" VerticalAlignment="Center"/><TextBox x:Name="EconomyNodeResourceTextBox" Grid.Row="1" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyNodeInspector_LostKeyboardFocus" ToolTip="Typed resource carried or stored by this node, e.g. Gold, Gems, XP"/>
                                        <TextBlock Grid.Row="2" Text="Initial" VerticalAlignment="Center"/><TextBox x:Name="EconomyNodeInitialTextBox" Grid.Row="2" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyNodeInspector_LostKeyboardFocus"/>
                                        <TextBlock Grid.Row="3" Text="Capacity" VerticalAlignment="Center"/><TextBox x:Name="EconomyNodeCapacityTextBox" Grid.Row="3" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyNodeInspector_LostKeyboardFocus"/>
                                        <TextBlock Grid.Row="4" Text="Notes" VerticalAlignment="Top" Margin="0,4,0,0"/><TextBox x:Name="EconomyNodeNotesTextBox" Grid.Row="4" Grid.Column="1" Height="38" Margin="0,4,0,0" TextWrapping="Wrap" AcceptsReturn="True" Padding="3,2" LostKeyboardFocus="EconomyNodeInspector_LostKeyboardFocus"/>
                                        <TextBlock x:Name="EconomyNodeKindHelpText" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Button Content="Trigger selected Action" Margin="6,5,6,6" Padding="7,2" Click="EconomyTriggerActionButton_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Subsystems / groups" Margin="0,8,0,0">
                                <StackPanel Margin="6"><ListBox x:Name="EconomySubsystemsListBox" Height="56"/><WrapPanel Margin="0,4,0,0"><Button Content="Collapse / expand" Padding="6,2" Click="EconomyToggleSubsystemButton_Click"/><Button Content="Ungroup" Padding="6,2" Margin="4,0,0,0" Click="EconomyUngroupSelectedButton_Click"/></WrapPanel></StackPanel>
                            </GroupBox>

                            <GroupBox Header="Flows" Margin="0,8,0,0">
                                <StackPanel Margin="6">
                                    <ListBox x:Name="EconomyLinksListBox" Height="72" ItemsSource="{Binding EconomyLinks}" DisplayMemberPath="Display" SelectionChanged="EconomyLinksListBox_SelectionChanged"/>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Label" VerticalAlignment="Center"/><TextBox x:Name="EconomyFlowLabelTextBox" Grid.Column="1" Grid.ColumnSpan="3" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus" ToolTip="Optional human-readable name shown on the diagram"/>
                                        <TextBlock Grid.Row="1" Text="Rate" VerticalAlignment="Center"/><TextBox x:Name="EconomyRateTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Padding="3,2" TextChanged="EconomyRateTextBox_TextChanged" ToolTip="Units/second. Built-ins include t, dt, source, target, rand and gauss."/>
                                        <TextBlock Grid.Row="2" Text="Condition" VerticalAlignment="Center"/><TextBox x:Name="EconomyConditionTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus" ToolTip="Flow runs only when this expression is greater than zero."/>
                                        <TextBlock Grid.Row="3" Text="Yield" VerticalAlignment="Center"/><TextBox x:Name="EconomyEfficiencyTextBox" Grid.Row="3" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Chance" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="EconomyChanceTextBox" Grid.Row="3" Grid.Column="3" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus" ToolTip="0..1 probability per activation"/>
                                        <TextBlock Grid.Row="4" Text="Interval" VerticalAlignment="Center"/><TextBox x:Name="EconomyIntervalTextBox" Grid.Row="4" Grid.Column="1" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus" ToolTip="0 = continuous; otherwise fires every N simulation seconds"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Delay" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="EconomyDelayTextBox" Grid.Row="4" Grid.Column="3" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus"/>
                                        <TextBlock Grid.Row="5" Text="Start / end" VerticalAlignment="Center"/><StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"><TextBox x:Name="EconomyStartTextBox" Width="72" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus"/><TextBlock Text="→" Margin="6,0" VerticalAlignment="Center"/><TextBox x:Name="EconomyEndTextBox" Width="72" Padding="3,2" LostKeyboardFocus="EconomyFlowInspector_LostKeyboardFocus" ToolTip="Blank or 0 end = no end time"/><CheckBox x:Name="EconomyFlowEnabledCheckBox" Content="Enabled" Margin="10,0,0,0" VerticalAlignment="Center" Checked="EconomyFlowEnabledCheckBox_Changed" Unchecked="EconomyFlowEnabledCheckBox_Changed"/></StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,5,0,0"><TextBlock x:Name="EconomyFlowStatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Width="285" TextWrapping="Wrap"/><Button Content="Delete flow" Padding="6,2" Click="EconomyDeleteFlowButton_Click"/></WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Converter recipes" Margin="0,8,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="Atomic crafting: incoming/outgoing connections define ingredients/products; their numeric rates become amounts per craft." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,4,0,0"><TextBlock Text="crafts/s" VerticalAlignment="Center"/><TextBox x:Name="EconomyRecipeRateTextBox" Width="80" Text="1" Margin="4,0" Padding="3,2"/><Button Content="Build from selected Converter" Padding="6,2" Click="EconomyCreateRecipeButton_Click"/></WrapPanel>
                                    <ListBox x:Name="EconomyRecipesListBox" Height="58" Margin="0,4,0,0"/><Button Content="Delete recipe" HorizontalAlignment="Left" Padding="6,2" Margin="0,4,0,0" Click="EconomyDeleteRecipeButton_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Resource appearance" Margin="0,8,0,0">
                                <StackPanel Margin="6"><ListBox x:Name="EconomyResourceStylesListBox" Height="58" SelectionChanged="EconomyResourceStylesListBox_SelectionChanged"/><WrapPanel Margin="0,4,0,0"><TextBlock Text="Color" VerticalAlignment="Center"/><TextBox x:Name="EconomyResourceColorTextBox" Width="72" Margin="3,0" Padding="2"/><TextBlock Text="Icon" VerticalAlignment="Center"/><TextBox x:Name="EconomyResourceIconTextBox" Width="35" Margin="3,0" Padding="2"/><TextBlock Text="Unit" VerticalAlignment="Center"/><TextBox x:Name="EconomyResourceUnitTextBox" Width="52" Margin="3,0" Padding="2"/><Button Content="Apply" Padding="6,2" Click="EconomyResourceStyleApplyButton_Click"/></WrapPanel></StackPanel>
                            </GroupBox>

                            <GroupBox Header="Economy parameters" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding EconomyParameters}" Margin="3">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBox Grid.Column="1" Text="{Binding Minimum, UpdateSourceTrigger=LostFocus}" Padding="2"/>
                                                <Slider Grid.Column="2" Margin="4,0" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Text="{Binding Maximum, UpdateSourceTrigger=LostFocus}" Padding="2"/>
                                                <TextBox Grid.Column="4" Margin="4,0,0,0" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Padding="2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="Scenarios &amp; player cohorts" Margin="0,8,0,0">
                                <StackPanel Margin="6">
                                    <TextBlock Text="Scenarios capture a tuning setup. Cohorts capture the same parameters for different player types." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,5,0,0"><TextBox x:Name="EconomyScenarioNameTextBox" Width="120" Text="Baseline" Padding="3,2"/><Button Content="Capture scenario" Padding="6,2" Margin="4,0,0,0" Click="EconomyCaptureScenarioButton_Click"/></WrapPanel>
                                    <WrapPanel Margin="0,4,0,0"><ComboBox x:Name="EconomyScenarioComboBox" Width="150" DisplayMemberPath="Name"/><Button Content="Apply" Padding="6,2" Margin="4,0,0,0" Click="EconomyApplyScenarioButton_Click"/><Button Content="Delete" Padding="6,2" Margin="4,0,0,0" Click="EconomyDeleteScenarioButton_Click"/></WrapPanel>
                                    <WrapPanel Margin="0,7,0,0"><TextBox x:Name="EconomyCohortNameTextBox" Width="105" Text="Casual" Padding="3,2"/><TextBlock Text="weight" Margin="6,0,3,0" VerticalAlignment="Center"/><TextBox x:Name="EconomyCohortWeightTextBox" Width="48" Text="1" Padding="3,2"/><Button Content="Capture cohort" Padding="6,2" Margin="4,0,0,0" Click="EconomyCaptureCohortButton_Click"/></WrapPanel>
                                    <WrapPanel Margin="0,4,0,0"><ComboBox x:Name="EconomyCohortComboBox" Width="150" DisplayMemberPath="Name"/><Button Content="Apply" Padding="6,2" Margin="4,0,0,0" Click="EconomyApplyCohortButton_Click"/><Button Content="Delete" Padding="6,2" Margin="4,0,0,0" Click="EconomyDeleteCohortButton_Click"/></WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <Button Content="Delete selected node" HorizontalAlignment="Left" Padding="8,3" Margin="0,8,0,0" Click="EconomyDeleteNodeButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="HlslLabLeftPanel" Grid.RowSpan="6" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,5,4">
                                <DockPanel>
                                    <TextBlock Text="HLSL Lab" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="← Function Lab" Padding="7,2" Click="CloseHlslLabButton_Click"/>
                                </DockPanel>
                                <TextBlock Text="Write HLSL, compile it with the Windows shader compiler, and see the pixel shader running immediately. Function Lab translation is optional." Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9"/>

                                <Expander Header="How to use this lab" IsExpanded="True" Margin="0,0,0,8">
                                    <StackPanel Margin="7,4,3,5">
                                        <TextBlock Text="1. Write or insert a shader.  2. Press Compile &amp; Run.  3. Fix any compiler diagnostics shown under Live preview.  4. Use Play/Pause to test time-driven code.  5. Search Dictionary when an intrinsic or GPU concept is unfamiliar." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                        <TextBlock Text="Live preview is real HLSL execution through WPF's pixel-shader path (ps_3_0). You can still translate Function Lab maths into the editor, but the preview is driven by the code in the shader editor." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Expander>

                                <GroupBox Header="Expression → HLSL">
                                    <StackPanel Margin="6">
                                        <TextBlock Text="Source expression" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="HlslSourceComboBox" Margin="0,4,0,0" DisplayMemberPath="Expression" SelectionChanged="HlslSourceComboBox_SelectionChanged" ToolTip="Choose any expression from Function Lab"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Translate" Padding="8,3" Click="RefreshHlslPreviewButton_Click"/>
                                            <Button Content="New scratch" Padding="8,3" Margin="5,0,0,0" Click="NewHlslScratchButton_Click"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Button Content="Copy" Padding="8,3" Click="CopyHlslPreviewButton_Click"/>
                                            <Button Content="Save .hlsl…" Padding="8,3" Margin="5,0,0,0" Click="SaveHlslPreviewButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Starter templates" Margin="0,8,0,0">
                                    <StackPanel Margin="6">
                                        <ComboBox x:Name="HlslTemplateComboBox" SelectedIndex="0">
                                            <ComboBoxItem Content="Animated plasma"/>
                                            <ComboBoxItem Content="Mandelbrot escape"/>
                                            <ComboBoxItem Content="Animated SDF circles"/>
                                            <ComboBoxItem Content="Animated value noise"/>
                                            <ComboBoxItem Content="Complex domain colour"/>
                                        </ComboBox>
                                        <Button Content="Insert template" HorizontalAlignment="Left" Padding="8,3" Margin="0,5,0,0" Click="InsertHlslTemplateButton_Click"/>
                                    </StackPanel>
                                </GroupBox>

                                <Expander Header="Complex numbers on the GPU" Margin="0,8,0,0" IsExpanded="False">
                                    <StackPanel Margin="7,4,3,4">
                                        <TextBlock Text="HLSL has no native complex scalar. Represent a+bi as float2(a,b). Addition is ordinary vector addition; multiplication, division, powers and transcendental functions need helper functions." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                        <TextBlock Text="float2 z = float2(x, y);" FontFamily="Consolas" FontSize="10.5" Margin="0,5,0,0"/>
                                        <TextBlock Text="float2 c = float2(cx, cy);" FontFamily="Consolas" FontSize="10.5"/>
                                    </StackPanel>
                                </Expander>

                                <Expander Header="CPU expression vs shader" Margin="0,6,0,0" IsExpanded="False">
                                    <TextBlock Margin="7,4,3,5" Text="The calculator can evaluate general recurrence, numerical derivatives and integrals on the CPU. Automatic HLSL translation is deliberately stricter: bounded fractal helpers and algebraic complex operations translate directly, while arbitrary recurrence/integration asks you to write the loop explicitly. This avoids silently generating an expensive shader." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                </Expander>

                                <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Useful recurrence syntax" FontWeight="SemiBold"/>
                                        <TextBlock Text="recurrence(z[n+1]=z[n]^2+c, z[0]=0, 80)" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="escape(z[n+1]=z[n]^2+c, z[0]=0, 80, 2)" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="LaTeX-like z_{n+1}, z_n and z_0 forms are accepted too." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GraphHeadingText" Text="Graph" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <WrapPanel x:Name="FunctionGraphToolbar" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Mode"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="PlotModeComboBox"
                                      Width="76"
                                      Height="30"
                                      SelectedIndex="0"
                                      Margin="0,0,8,0"
                                      SelectionChanged="PlotModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="2D" Tag="2D"/>
                                <ComboBoxItem Content="3D" Tag="3D"/>
                            </ComboBox>
                            <TextBlock x:Name="GraphStatusText"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="HLSL Lab" Click="OpenHlslLabButton_Click" ToolTip="Open the shader editor, source preview and HLSL dictionary"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Export CSV" Click="ExportCsvButton_Click"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Engine export" Click="ExportEngineButton_Click"/>
                            <ComboBox x:Name="RenderQualityComboBox" Width="82" Height="30" Margin="6,0,0,0" SelectedIndex="1" SelectionChanged="RenderQualityComboBox_SelectionChanged" ToolTip="Sampling/render quality">
                                <ComboBoxItem Content="Draft"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Ultra"/>
                            </ComboBox>
                            <Button Style="{StaticResource ToolbarButton}" Content="PNG" Click="CapturePngButton_Click" ToolTip="Capture the graph area as PNG"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="GIF" Click="CaptureGifButton_Click" ToolTip="Export one timeline loop as an animated GIF"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Fit graph" Click="FitGraphButton_Click"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Reset" Click="ResetViewButton_Click"/>
                        </WrapPanel>
                        <WrapPanel x:Name="CurveGraphToolbar" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="CurveGraphStatusText" Text="Click to place keys · drag keys or tangent handles" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Fit curve" Click="FitCurveDesignerButton_Click"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Reset view" Click="ResetViewButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <TabControl x:Name="GraphToolsTabs"
                                Grid.Row="1"
                                Margin="2,0,2,6"
                                SelectionChanged="GraphToolsTabs_SelectionChanged">
                        <TabItem x:Name="TimelinePanel" Header="Timeline">
                        <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ToolbarButton}" Content="▶" Padding="8,3" Margin="0" Click="TimelinePlayButton_Click" ToolTip="Play"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Ⅱ" Padding="8,3" Click="TimelinePauseButton_Click" ToolTip="Pause"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="■" Padding="8,3" Click="TimelineStopButton_Click" ToolTip="Stop and return to the start"/>
                            <Slider x:Name="TimelineSlider" Width="165" Margin="9,0,5,0" Minimum="0" Maximum="10" ValueChanged="TimelineSlider_ValueChanged"/>
                            <TextBlock Text="t" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0"/>
                            <TextBox x:Name="TimelineTimeTextBox" Width="55" Padding="3,2" Text="0" LostKeyboardFocus="TimelineSetting_LostKeyboardFocus"/>
                            <TextBlock Text="range" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <TextBox x:Name="TimelineStartTextBox" Width="48" Padding="3,2" Text="0" LostKeyboardFocus="TimelineSetting_LostKeyboardFocus"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TimelineEndTextBox" Width="48" Padding="3,2" Text="10" LostKeyboardFocus="TimelineSetting_LostKeyboardFocus"/>
                            <TextBlock Text="speed" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,3,0"/>
                            <TextBox x:Name="TimelineSpeedTextBox" Width="46" Padding="3,2" Text="1" LostKeyboardFocus="TimelineSetting_LostKeyboardFocus"/>
                            <TextBlock Text="×" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="2,0,5,0"/>
                            <CheckBox x:Name="TimelineLoopCheckBox" Content="Loop" IsChecked="True" VerticalAlignment="Center" Checked="TimelineLoopCheckBox_Changed" Unchecked="TimelineLoopCheckBox_Changed"/>
                        </WrapPanel>

                        </Border>
                    
                        </TabItem>
                        <TabItem x:Name="PlotRangePanel" Header="2D view">
                        <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="X" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="PlotMinXTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="PlotMaxXTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Y" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="PlotMinYTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="PlotMaxYTextBox" Width="62" Padding="4,2"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Apply range" Margin="8,0,0,0" Click="ApplyPlotRangeButton_Click"/>
                        </WrapPanel>

                        </Border>
                    
                        </TabItem>
                        <TabItem x:Name="SurfaceRangePanel" Header="3D view" Visibility="Collapsed">
                        <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="X" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinXTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxXTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Y" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinYTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxYTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Z" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinZTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxZTextBox" Width="62" Padding="4,2"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Apply range" Margin="8,0,0,0" Click="ApplySurfaceRangeButton_Click"/>
                        </WrapPanel>

                        </Border>
                    
                        </TabItem>
                        <TabItem x:Name="AnalysisToolsPanel" Header="Inspect &amp; fields">
                        <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6">
                        <Grid>
                            <WrapPanel x:Name="TwoDToolsPanel">
                                <TextBlock Text="Inspect" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ShowDerivativeCheckBox" Content="Derivative overlay" VerticalAlignment="Center" Margin="0,0,10,0" Checked="AnalysisOption_Changed" Unchecked="AnalysisOption_Changed"/>
                                <CheckBox x:Name="ComparisonEnabledCheckBox" Content="Compare" VerticalAlignment="Center" Margin="0,0,6,0" Checked="AnalysisOption_Changed" Unchecked="AnalysisOption_Changed"/>
                                <ComboBox x:Name="ComparisonAComboBox" Width="120" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="AnalysisOption_Changed" ToolTip="Expression A"/>
                                <ComboBox x:Name="ComparisonModeComboBox" Width="92" Margin="5,0" SelectedIndex="0" SelectionChanged="AnalysisOption_Changed">
                                    <ComboBoxItem Content="A - B"/>
                                    <ComboBoxItem Content="|A - B|"/>
                                    <ComboBoxItem Content="A / B"/>
                                </ComboBox>
                                <ComboBox x:Name="ComparisonBComboBox" Width="120" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="AnalysisOption_Changed" ToolTip="Expression B"/>
                                <Button Content="Analyze A" Padding="7,2" Margin="6,0,0,0" Click="AnalyzeExpressionButton_Click" ToolTip="Find numerical roots and extrema; intersections use A and B"/>
                                <Separator Width="10" Opacity="0"/>
                                <CheckBox x:Name="FieldPreviewEnabledCheckBox" Content="Field preview" VerticalAlignment="Center" Checked="FieldPreviewOption_Changed" Unchecked="FieldPreviewOption_Changed"/>
                                <ComboBox x:Name="FieldPreviewExpressionComboBox" Width="130" Margin="5,0" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="FieldPreviewOption_Changed" ToolTip="2D scalar, fractal, or complex-field source"/>
                                <ComboBox x:Name="FieldPreviewPaletteComboBox" Width="88" SelectedIndex="1" SelectionChanged="FieldPreviewOption_Changed">
                                    <ComboBoxItem Content="Grayscale"/>
                                    <ComboBoxItem Content="Signed"/>
                                    <ComboBoxItem Content="Heat"/>
                                    <ComboBoxItem Content="Fractal"/>
                                </ComboBox>
                                <Button Content="Export texture" Padding="7,2" Margin="5,0,0,0" Click="ExportFieldTextureButton_Click"/>
                            </WrapPanel>

                            <WrapPanel x:Name="ThreeDToolsPanel" Visibility="Collapsed">
                                <TextBlock Text="Display" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="SurfaceDisplayModeComboBox" Width="122" SelectedIndex="0" SelectionChanged="SurfaceDisplayModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Solid"/>
                                    <ComboBoxItem Content="Wireframe"/>
                                    <ComboBoxItem Content="Solid + wire"/>
                                    <ComboBoxItem Content="Height bands"/>
                                    <ComboBoxItem Content="Slope"/>
                                    <ComboBoxItem Content="Normals"/>
                                </ComboBox>
                                <Separator Width="10" Opacity="0"/>
                                <CheckBox x:Name="CrossSectionEnabledCheckBox" Content="Cross-section" VerticalAlignment="Center" Margin="0,0,6,0" Checked="CrossSectionOption_Changed" Unchecked="CrossSectionOption_Changed"/>
                                <ComboBox x:Name="CrossSectionExpressionComboBox" Width="140" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="CrossSectionOption_Changed" ToolTip="Scalar surface to slice"/>
                                <ComboBox x:Name="CrossSectionAxisComboBox" Width="58" Margin="5,0" SelectedIndex="1" SelectionChanged="CrossSectionOption_Changed">
                                    <ComboBoxItem Content="X"/>
                                    <ComboBoxItem Content="Y"/>
                                </ComboBox>
                                <TextBox x:Name="CrossSectionValueTextBox" Width="58" Padding="3,2" Text="0" LostKeyboardFocus="CrossSectionValueTextBox_LostKeyboardFocus" ToolTip="Fixed axis value"/>
                                <TextBlock Text="Right-click the surface to probe" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </WrapPanel>
                        </Grid>

                        </Border>
                    
                        </TabItem>
                        <TabItem x:Name="DynamicsInspectorPanel" Header="Dynamics" Visibility="Collapsed">
                            <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Context, not a permanent tutorial panel. -->
                                    <Grid Margin="2,0,2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="DynamicsSummaryTitle"
                                                           Text="Dynamical system"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text=" ⓘ"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Cursor="Help"
                                                           ToolTip="{Binding Text, ElementName=DynamicsSummaryText}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DynamicsCurrentStateText"
                                                       Margin="0,3,0,0"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock x:Name="DynamicsSummaryText" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <CheckBox x:Name="DynamicsShowStartCheckBox"
                                                      Content="Start"
                                                      IsChecked="True"
                                                      Margin="0,0,10,0"
                                                      ToolTip="Show the initial state on the phase trajectory"
                                                      Checked="DynamicsVisualOption_Changed"
                                                      Unchecked="DynamicsVisualOption_Changed"/>
                                            <CheckBox x:Name="DynamicsShowDirectionCheckBox"
                                                      Content="Arrows"
                                                      IsChecked="True"
                                                      ToolTip="Show the direction of travel through state space"
                                                      Checked="DynamicsVisualOption_Changed"
                                                      Unchecked="DynamicsVisualOption_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Grid.Row="1" Margin="0,0,0,5" Background="{DynamicResource BorderBrush}"/>

                                    <TabControl x:Name="DynamicsInspectorTabs"
                                                Grid.Row="2"
                                                Height="190"
                                                BorderThickness="0"
                                                SelectionChanged="DynamicsInspectorTabs_SelectionChanged">
                                        <TabItem Header="Time series">
                                            <Grid Margin="5">
                                                <Canvas x:Name="DynamicsTimeSeriesCanvas"
                                                        Background="{DynamicResource GraphBackgroundBrush}"
                                                        SizeChanged="DynamicsTimeSeriesCanvas_SizeChanged"/>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="Table">
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <WrapPanel Margin="0,0,0,5">
                                                    <TextBlock Text="Rows" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    <ComboBox x:Name="DynamicsTableRowsComboBox"
                                                              Width="72"
                                                              Margin="5,0,10,0"
                                                              SelectedIndex="1"
                                                              SelectionChanged="DynamicsTableOption_Changed">
                                                        <ComboBoxItem Content="40"/>
                                                        <ComboBoxItem Content="100"/>
                                                        <ComboBoxItem Content="250"/>
                                                    </ComboBox>
                                                    <CheckBox x:Name="DynamicsTableDerivativesCheckBox"
                                                              Content="Derivatives"
                                                              IsChecked="True"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Show direction and rate of change for each state"
                                                              Checked="DynamicsTableOption_Changed"
                                                              Unchecked="DynamicsTableOption_Changed"/>
                                                </WrapPanel>
                                                <DataGrid x:Name="DynamicsDataGrid"
                                                          Grid.Row="1"
                                                          IsReadOnly="True"
                                                          AutoGenerateColumns="True"
                                                          SelectionMode="Single"
                                                          SelectionChanged="DynamicsDataGrid_SelectionChanged"/>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <Grid x:Name="GraphSurface"
                          Grid.Row="2"
                          Background="{DynamicResource GraphBackgroundBrush}"
                          ClipToBounds="True"
                          SizeChanged="GraphSurface_SizeChanged">
                        <Image x:Name="FieldPreviewImage" Visibility="Collapsed" Stretch="Fill" IsHitTestVisible="False" Opacity="0.88"/>

                        <Canvas x:Name="PlotCanvas"
                                Background="Transparent"
                                MouseMove="PlotCanvas_MouseMove"
                                MouseLeave="PlotCanvas_MouseLeave"
                                MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                                MouseWheel="PlotCanvas_MouseWheel"/>

                        <Viewport3D x:Name="SurfaceViewport3D"
                                    Visibility="Collapsed"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="SurfaceViewport3D_MouseLeftButtonDown"
                                    MouseLeftButtonUp="SurfaceViewport3D_MouseLeftButtonUp"
                                    MouseMove="SurfaceViewport3D_MouseMove"
                                    MouseWheel="SurfaceViewport3D_MouseWheel"
                                    MouseRightButtonDown="SurfaceViewport3D_MouseRightButtonDown">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="SurfaceCamera"
                                                   FieldOfView="42"
                                                   NearPlaneDistance="0.1"
                                                   FarPlaneDistance="200"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="SurfaceSceneVisual"/>
                        </Viewport3D>

                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                            <Line x:Name="CrosshairVertical"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>
                            <Line x:Name="CrosshairHorizontal"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>

                            <Border x:Name="HoverPanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource OverlayBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="8"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock x:Name="HoverXText" FontWeight="SemiBold"/>
                                    <ItemsControl x:Name="HoverValuesList" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Canvas>

                        <Border x:Name="AnalysisResultsPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="{DynamicResource OverlayBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Numerical analysis" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AnalysisResultsText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="390"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SurfaceProbePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Background="{DynamicResource OverlayBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Probe" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SurfaceProbeText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="310"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CrossSectionPreview"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Width="300"
                                Height="185"
                                Background="{DynamicResource OverlayBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CrossSectionTitleText" Text="Cross-section" FontWeight="SemiBold" FontSize="11"/>
                                <Canvas x:Name="CrossSectionCanvas" Grid.Row="1" Width="282" Height="145" Margin="0,5,0,0" Background="{DynamicResource GraphBackgroundBrush}"/>
                            </Grid>
                        </Border>

                        <Border x:Name="SurfaceLegend"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Background="{DynamicResource OverlayBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="3D: z=f(x,y), curves, parametric/implicit surfaces and 3-state dynamics" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock FontSize="11">
                                    <Run Text="x" Foreground="#FFBE4A4A" FontWeight="SemiBold"/>
                                    <Run Text=" axis  ·  "/>
                                    <Run Text="y" Foreground="#FF439162" FontWeight="SemiBold"/>
                                    <Run Text=" axis  ·  "/>
                                    <Run Text="z" Foreground="#FF496FB2" FontWeight="SemiBold"/>
                                    <Run Text=" axis"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>


                        <Grid x:Name="HlslWorkspacePanel" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="2,0,2,8">
                                <DockPanel>
                                    <StackPanel>
                                        <TextBlock Text="Shader workspace" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="The editor is the source of truth. Compile &amp; Run executes the HLSL shown here in the live GPU preview." Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5"/>
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Content="Compile &amp; Run" Padding="9,3" Click="CompileAndRunHlslButton_Click"/>
                                        <Button x:Name="HlslPlayPauseButton" Content="Play" Padding="8,3" Margin="5,0,0,0" IsEnabled="False" Click="ToggleHlslPlaybackButton_Click"/>
                                        <Button x:Name="HlslRestartTimeButton" Content="Restart" Padding="8,3" Margin="5,0,0,0" IsEnabled="False" Click="RestartHlslTimeButton_Click"/>
                                        <TextBlock x:Name="HlslRuntimeTimeText" Text="t 0.00s" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock x:Name="HlslEditorHintText" Text="HLSL" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <TabControl x:Name="HlslWorkspaceTabControl" Grid.Row="1" Margin="0" SelectedIndex="0">
                                <TabItem Header="Shader editor">
                                    <Grid Margin="6">
                                        <TextBox x:Name="HlslPreviewTextBox"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="9"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 SpellCheck.IsEnabled="False"
                                                 TextChanged="HlslPreviewTextBox_TextChanged"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Live preview">
                                    <Grid Margin="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,7">
                                            <WrapPanel DockPanel.Dock="Right">
                                                <TextBlock Text="x" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,3,0"/>
                                                <TextBox x:Name="HlslMinXTextBox" Width="55" Text="-2" Padding="4,2" TextChanged="HlslPreviewRangeTextBox_TextChanged"/>
                                                <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0"/>
                                                <TextBox x:Name="HlslMaxXTextBox" Width="55" Text="2" Padding="4,2" TextChanged="HlslPreviewRangeTextBox_TextChanged"/>
                                                <TextBlock Text="y" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,3,0"/>
                                                <TextBox x:Name="HlslMinYTextBox" Width="55" Text="-2" Padding="4,2" TextChanged="HlslPreviewRangeTextBox_TextChanged"/>
                                                <TextBlock Text="→" VerticalAlignment="Center" Margin="4,0"/>
                                                <TextBox x:Name="HlslMaxYTextBox" Width="55" Text="2" Padding="4,2" TextChanged="HlslPreviewRangeTextBox_TextChanged"/>
                                                <Button Content="Use source range" Padding="7,2" Margin="7,0,0,0" Click="UseSourceRangeForHlslButton_Click"/>
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="HlslCompileStatusText" Text="Not compiled" FontWeight="SemiBold"/>
                                                <TextBlock Text=" · WPF pixel shader 3.0" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource GraphBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                            <Border x:Name="HlslGpuSurface"
                                                    Background="{DynamicResource GraphBackgroundBrush}"
                                                    SizeChanged="HlslGpuSurface_SizeChanged"
                                                    MouseWheel="HlslGpuSurface_MouseWheel"
                                                    ToolTip="Mouse wheel adjusts the preview range around the cursor."/>
                                        </Border>
                                        <Grid Grid.Row="2" Margin="0,7,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="72"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Compiler output" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HlslCompilerOutputTextBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="6" Text="Press Compile &amp; Run to compile the editor as a real pixel shader."/>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Calculator source">
                                    <Grid Margin="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,7">
                                            <Button DockPanel.Dock="Right" Content="Refresh source" Padding="8,3" Click="RefreshHlslSourcePreviewButton_Click"/>
                                            <TextBlock x:Name="HlslSourcePreviewStatusText" Text="Optional CPU reference for the selected Function Lab expression" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource GraphBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                                            <Image x:Name="HlslSourcePreviewImage" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Dictionary">
                                    <Grid Margin="7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="Search" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                                            <TextBox x:Name="HlslDictionaryFilterTextBox" Padding="5,3" TextChanged="HlslDictionaryFilterTextBox_TextChanged" ToolTip="Search functions, syntax, categories and HLSL notes"/>
                                        </DockPanel>
                                        <ListBox x:Name="HlslDictionaryListBox" Grid.Row="1" Margin="0,7,0,0" MouseDoubleClick="HlslDictionaryListBox_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,6">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="10,0,0,0"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Signature}" FontFamily="Consolas" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding HlslNote}" Foreground="#FF496FB2" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Guide">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                                            <TextBlock Text="Live HLSL preview" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="The editor is compiled with the Windows Direct3D shader compiler and loaded into a WPF ShaderEffect. Compile errors are real compiler diagnostics; a successful shader is the code actually driving the Live preview." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Text="GraphFunction shortcut" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <TextBlock Text="For quick experiments, define float, float2, float3 or float4 GraphFunction(...). The lab wraps it in a pixel-shader entry point. x/y come from the preview range and time/t comes from the live clock. Current Function Lab parameters are inserted as scalar values when names match." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="Full pixel shader" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <TextBlock Text="You can instead write float4 main(float2 uv : TEXCOORD0) : COLOR0. Reserved live-preview uniforms are gc_time, gc_minX, gc_maxX, gc_minY, gc_maxY, gc_width and gc_height; gc_mapUv(uv) converts normalized UVs to the current preview range." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="Preview target" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <TextBlock Text="WPF accepts Direct3D-era pixel shaders, so Live preview targets ps_3_0. Code meant for modern engine shader models can still be edited and saved here, but unsupported syntax will correctly fail the live compiler instead of being silently faked." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="Derivatives" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                            <TextBlock Text="ddx/ddy/fwidth are screen-space shader derivatives, not the same thing as derivative(expr,x) in the mathematical evaluator." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                            <TextBlock Text="Tip: double-click an item in Dictionary to append its signature and HLSL note as comments to the editor." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>

                        <Grid x:Name="EconomyWorkspacePanel" Grid.RowSpan="5" Background="{DynamicResource PanelBackgroundBrush}" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="1.15*"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource SubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="2,0,2,8">
                                <DockPanel>
                                    <TextBlock Text="Economy simulation" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource ToolbarButton}" Content="▶" Click="EconomyPlayButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Ⅱ" Click="EconomyPauseButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Step" Click="EconomyStepButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Reset" Click="EconomyResetButton_Click"/>
                                        <Button x:Name="EconomyReplayToggleButton" Style="{StaticResource ToolbarButton}" Content="Replay" Click="EconomyReplayToggleButton_Click"/>
                                        <Slider x:Name="EconomyReplaySlider" Width="120" Margin="5,0" IsEnabled="False" ValueChanged="EconomyReplaySlider_ValueChanged"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Export CSV" Click="EconomyExportCsvButton_Click"/>
                                        <TextBlock Text="dt" Margin="10,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBox x:Name="EconomyDtTextBox" Width="52" Text="0.1" Padding="3,2"/>
                                        <TextBlock Text="speed" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBox x:Name="EconomySpeedTextBox" Width="52" Text="1" Padding="3,2"/>
                                        <TextBlock Text="seed" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBox x:Name="EconomySeedTextBox" Width="66" Text="1337" Padding="3,2"/>
                                        <TextBlock x:Name="EconomyTimeText" Text="t = 0.00" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Canvas x:Name="EconomyCanvas" Background="{DynamicResource GraphBackgroundBrush}" ClipToBounds="True" SizeChanged="EconomyCanvas_SizeChanged" MouseLeftButtonDown="EconomyCanvas_MouseLeftButtonDown"/>
                                <Border x:Name="EconomyResourceLegendBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7" Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                        <StackPanel x:Name="EconomyResourceLegendPanel"/>
                                        <TextBlock Text="Line colour = resource · moving packets = accepted transfers" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.5" Margin="0,4,0,0"/>
                                        <TextBlock Text="◆ conversion · dashed = delayed · arrow/chevron = direction" Foreground="{DynamicResource MutedTextBrush}" FontSize="9.2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8" Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False">
                                    <TextBlock x:Name="EconomyDiagnosticsText" Text="Add nodes or load an example to begin." FontSize="11" TextWrapping="Wrap" MaxWidth="420"/>
                                </Border>
                            </Grid>
                            <TabControl Grid.Row="2" Margin="0,8,0,0">
                                <TabItem Header="History">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="Resource history" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <WrapPanel DockPanel.Dock="Right">
                                                <TextBlock Text="window (s)" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBox x:Name="EconomyHistoryWindowTextBox" Width="58" Text="30" Margin="4,0,8,0" Padding="3,2" TextChanged="EconomyHistoryDisplayTextChanged" ToolTip="Seconds of recent history to show. Use 0 for all recorded history."/>
                                                <TextBlock Text="Y max" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                                                <TextBox x:Name="EconomyHistoryYMaxTextBox" Width="58" Text="auto" Margin="4,0,8,0" Padding="3,2" TextChanged="EconomyHistoryDisplayTextChanged" ToolTip="Type a positive number for a fixed Y scale, or 'auto'."/>
                                                <CheckBox x:Name="EconomyHistoryCapacityCheckBox" Content="Capacities" IsChecked="False" Margin="2,0,8,0" VerticalAlignment="Center" Click="EconomyHistoryDisplayChanged" ToolTip="Show storage capacity guides."/>
                                                <Button Content="All" Padding="6,2" Margin="2,0" Click="EconomyHistorySeriesAllButton_Click"/>
                                                <Button Content="None" Padding="6,2" Margin="2,0" Click="EconomyHistorySeriesNoneButton_Click"/>
                                            </WrapPanel>
                                        </DockPanel>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="54" Margin="0,5,0,0">
                                            <WrapPanel x:Name="EconomyHistorySeriesPanel"/>
                                        </ScrollViewer>
                                        <Canvas x:Name="EconomyChartCanvas" Grid.Row="2" Background="{DynamicResource GraphBackgroundBrush}" Margin="0,5,0,0" SizeChanged="EconomyChartCanvas_SizeChanged"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Predictions">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel>
                                            <TextBlock Text="runs" VerticalAlignment="Center"/><TextBox x:Name="EconomyPredictionRunsTextBox" Width="58" Text="500" Margin="4,0,8,0" Padding="3,2"/>
                                            <TextBlock Text="horizon" VerticalAlignment="Center"/><TextBox x:Name="EconomyPredictionHorizonTextBox" Width="60" Text="30" Margin="4,0,8,0" Padding="3,2"/>
                                            <CheckBox x:Name="EconomyPopulationMixCheckBox" Content="Population mix" Margin="4,0,8,0" VerticalAlignment="Center" ToolTip="Choose cohorts according to their weights on each run"/>
                                            <Button x:Name="EconomyRunPredictionButton" Content="Run prediction" Padding="8,3" Click="EconomyRunPredictionButton_Click"/>
                                            <Button x:Name="EconomyCancelPredictionButton" Content="Cancel" Padding="8,3" Margin="4,0,0,0" Click="EconomyCancelPredictionButton_Click" IsEnabled="False"/>
                                        </WrapPanel>
                                        <TextBox x:Name="EconomyPredictionResultsTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Debugger">
                                    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel><Button Content="Break on selected flow" Padding="7,2" Click="EconomyBreakpointButton_Click"/><TextBlock x:Name="EconomyBreakpointText" Text="No breakpoint" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/><Button Content="Clear log" Padding="7,2" Click="EconomyClearDebuggerButton_Click"/></WrapPanel>
                                        <ListBox x:Name="EconomyDebuggerListBox" Grid.Row="1" Margin="0,6,0,0" FontFamily="Consolas" FontSize="10">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1">
                                                        <TextBlock TextWrapping="Wrap">
                                                            <Run>
                                                                <Run.Text>
                                                                    <Binding Path="Time" StringFormat="t={0:0.###}  "/>
                                                                </Run.Text>
                                                            </Run>
                                                            <Run Text="{Binding Flow}"/>
                                                            <Run>
                                                                <Run.Text>
                                                                    <Binding Path="Reason" StringFormat="  · {0}"/>
                                                                </Run.Text>
                                                            </Run>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Sensitivity">
                                    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button x:Name="EconomySensitivityButton" Content="Analyse selected target" Padding="8,3" Click="EconomySensitivityButton_Click"/><TextBlock Text="Perturbs each free parameter by 5% of its range using a common seed." Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/></WrapPanel><TextBox x:Name="EconomySensitivityTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
                                </TabItem>
                                <TabItem Header="Balance search">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel>
                                            <TextBlock Text="Target" VerticalAlignment="Center"/><ComboBox x:Name="EconomyTargetNodeComboBox" Width="135" Margin="4,0" DisplayMemberPath="Name"/>
                                            <TextBlock Text="min" VerticalAlignment="Center"/><TextBox x:Name="EconomyTargetMinTextBox" Width="58" Text="0" Margin="4,0" Padding="3,2"/>
                                            <TextBlock Text="max" VerticalAlignment="Center"/><TextBox x:Name="EconomyTargetMaxTextBox" Width="58" Text="100" Margin="4,0" Padding="3,2"/>
                                            <Button Content="Add target" Padding="7,2" Margin="4,0" Click="EconomyAddTargetButton_Click"/>
                                            <Button Content="Remove" Padding="7,2" Click="EconomyDeleteTargetButton_Click"/>
                                        </WrapPanel>
                                        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                                            <ListBox x:Name="EconomyTargetsListBox" Width="280" Height="54" ItemsSource="{Binding EconomyTargets}" DisplayMemberPath="Display"/>
                                            <StackPanel Margin="8,0,0,0"><WrapPanel><TextBlock Text="candidates" VerticalAlignment="Center"/><TextBox x:Name="EconomyOptimizationCandidatesTextBox" Width="58" Text="300" Margin="4,0" Padding="3,2"/><Button x:Name="EconomyOptimizationSearchButton" Content="Search" Padding="8,2" Click="EconomyOptimizeButton_Click"/><Button x:Name="EconomyCancelOptimizationButton" Content="Cancel" Padding="8,2" Margin="4,0,0,0" Click="EconomyCancelOptimizationButton_Click" IsEnabled="False"/><Button x:Name="EconomyApplyOptimizationButton" Content="Apply best" Padding="8,2" Margin="4,0,0,0" Click="EconomyApplyOptimizationButton_Click" IsEnabled="False"/></WrapPanel><TextBlock Text="Searches parameter min/max ranges; selected scenario/cohort overrides stay fixed." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/></StackPanel>
                                        </WrapPanel>
                                        <TextBox x:Name="EconomyOptimizationResultsTextBox" Grid.Row="2" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="ViewRangeText" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="FooterHintText"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Enter adds a line · Ctrl+Enter refreshes · Ctrl+Space suggestions · Esc clears the active expression"/>
                <TextBlock x:Name="InteractionHintText"
                           DockPanel.Dock="Right"
                           Margin="0,0,18,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Scroll to zoom · drag to pan"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
