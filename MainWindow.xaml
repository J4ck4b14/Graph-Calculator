                            <CheckBox x:Name="TimelineLoopCheckBox" Content="Loop" IsChecked="True" VerticalAlignment="Center" Checked="TimelineLoopCheckBox_Changed" Unchecked="TimelineLoopCheckBox_Changed"/>
                        </WrapPanel>
                    </Border>

                    <Border x:Name="PlotRangePanel"
                            Grid.Row="2"
                            Background="#FFF8F9FB"
                            BorderBrush="#FFE3E6EA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="2,0,2,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="View" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="X" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="PlotMinXTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="PlotMaxXTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Y" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="PlotMinYTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="PlotMaxYTextBox" Width="62" Padding="4,2"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Apply range" Margin="8,0,0,0" Click="ApplyPlotRangeButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border x:Name="SurfaceRangePanel"
                            Grid.Row="2"
                            Visibility="Collapsed"
                            Background="#FFF8F9FB"
                            BorderBrush="#FFE3E6EA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="2,0,2,8">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="X" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinXTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxXTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Y" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinYTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxYTextBox" Width="62" Padding="4,2" Margin="0,0,12,0"/>

                            <TextBlock Text="Z" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="SurfaceMinZTextBox" Width="62" Padding="4,2"/>
                            <TextBlock Text="to" Foreground="#FF6B7280" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox x:Name="SurfaceMaxZTextBox" Width="62" Padding="4,2"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Apply range" Margin="8,0,0,0" Click="ApplySurfaceRangeButton_Click"/>
                        </WrapPanel>
                    </Border>

                    <Border x:Name="AnalysisToolsPanel"
                            Grid.Row="3"
                            Background="#FFF8F9FB"
                            BorderBrush="#FFE3E6EA"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="2,0,2,8">
                        <Grid>
                            <WrapPanel x:Name="TwoDToolsPanel">
                                <TextBlock Text="Inspect" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="ShowDerivativeCheckBox" Content="Derivative overlay" VerticalAlignment="Center" Margin="0,0,10,0" Checked="AnalysisOption_Changed" Unchecked="AnalysisOption_Changed"/>
                                <CheckBox x:Name="ComparisonEnabledCheckBox" Content="Compare" VerticalAlignment="Center" Margin="0,0,6,0" Checked="AnalysisOption_Changed" Unchecked="AnalysisOption_Changed"/>
                                <ComboBox x:Name="ComparisonAComboBox" Width="120" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="AnalysisOption_Changed" ToolTip="Expression A"/>
                                <ComboBox x:Name="ComparisonModeComboBox" Width="92" Margin="5,0" SelectedIndex="0" SelectionChanged="AnalysisOption_Changed">
                                    <ComboBoxItem Content="A - B"/>
                                    <ComboBoxItem Content="|A - B|"/>
                                    <ComboBoxItem Content="A / B"/>
                                </ComboBox>
                                <ComboBox x:Name="ComparisonBComboBox" Width="120" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="AnalysisOption_Changed" ToolTip="Expression B"/>
                                <Button Content="Analyze A" Padding="7,2" Margin="6,0,0,0" Click="AnalyzeExpressionButton_Click" ToolTip="Find numerical roots and extrema; intersections use A and B"/>
                                <Separator Width="10" Opacity="0"/>
                                <CheckBox x:Name="FieldPreviewEnabledCheckBox" Content="Field preview" VerticalAlignment="Center" Checked="FieldPreviewOption_Changed" Unchecked="FieldPreviewOption_Changed"/>
                                <ComboBox x:Name="FieldPreviewExpressionComboBox" Width="130" Margin="5,0" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="FieldPreviewOption_Changed" ToolTip="2D scalar field / texture source"/>
                                <ComboBox x:Name="FieldPreviewPaletteComboBox" Width="88" SelectedIndex="1" SelectionChanged="FieldPreviewOption_Changed">
                                    <ComboBoxItem Content="Grayscale"/>
                                    <ComboBoxItem Content="Signed"/>
                                    <ComboBoxItem Content="Heat"/>
                                </ComboBox>
                                <Button Content="Export texture" Padding="7,2" Margin="5,0,0,0" Click="ExportFieldTextureButton_Click"/>
                            </WrapPanel>

                            <WrapPanel x:Name="ThreeDToolsPanel" Visibility="Collapsed">
                                <TextBlock Text="Display" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="SurfaceDisplayModeComboBox" Width="122" SelectedIndex="0" SelectionChanged="SurfaceDisplayModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Solid"/>
                                    <ComboBoxItem Content="Wireframe"/>
                                    <ComboBoxItem Content="Solid + wire"/>
                                    <ComboBoxItem Content="Height bands"/>
                                    <ComboBoxItem Content="Slope"/>
                                    <ComboBoxItem Content="Normals"/>
                                </ComboBox>
                                <Separator Width="10" Opacity="0"/>
                                <CheckBox x:Name="CrossSectionEnabledCheckBox" Content="Cross-section" VerticalAlignment="Center" Margin="0,0,6,0" Checked="CrossSectionOption_Changed" Unchecked="CrossSectionOption_Changed"/>
                                <ComboBox x:Name="CrossSectionExpressionComboBox" Width="140" ItemsSource="{Binding Expressions}" DisplayMemberPath="Expression" SelectionChanged="CrossSectionOption_Changed" ToolTip="Scalar surface to slice"/>
                                <ComboBox x:Name="CrossSectionAxisComboBox" Width="58" Margin="5,0" SelectedIndex="1" SelectionChanged="CrossSectionOption_Changed">
                                    <ComboBoxItem Content="X"/>
                                    <ComboBoxItem Content="Y"/>
                                </ComboBox>
                                <TextBox x:Name="CrossSectionValueTextBox" Width="58" Padding="3,2" Text="0" LostKeyboardFocus="CrossSectionValueTextBox_LostKeyboardFocus" ToolTip="Fixed axis value"/>
                                <TextBlock Text="Right-click the surface to probe" Foreground="#FF7A818C" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="GraphSurface"
                          Grid.Row="4"
                          Background="#FFFBFCFE"
                          ClipToBounds="True"
                          SizeChanged="GraphSurface_SizeChanged">
                        <Image x:Name="FieldPreviewImage" Visibility="Collapsed" Stretch="Fill" IsHitTestVisible="False" Opacity="0.88"/>

                        <Canvas x:Name="PlotCanvas"
                                Background="Transparent"
                                MouseMove="PlotCanvas_MouseMove"
                                MouseLeave="PlotCanvas_MouseLeave"
                                MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                                MouseWheel="PlotCanvas_MouseWheel"/>

                        <Viewport3D x:Name="SurfaceViewport3D"
                                    Visibility="Collapsed"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="SurfaceViewport3D_MouseLeftButtonDown"
                                    MouseLeftButtonUp="SurfaceViewport3D_MouseLeftButtonUp"
                                    MouseMove="SurfaceViewport3D_MouseMove"
                                    MouseWheel="SurfaceViewport3D_MouseWheel"
                                    MouseRightButtonDown="SurfaceViewport3D_MouseRightButtonDown">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="SurfaceCamera"
                                                   FieldOfView="42"
                                                   NearPlaneDistance="0.1"
                                                   FarPlaneDistance="200"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D x:Name="SurfaceSceneVisual"/>
                        </Viewport3D>

                        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                            <Line x:Name="CrosshairVertical"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>
                            <Line x:Name="CrosshairHorizontal"
                                  Stroke="#66717A86"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Visibility="Collapsed"/>

                            <Border x:Name="HoverPanel"
                                    Visibility="Collapsed"
                                    Background="#F2FFFFFF"
                                    BorderBrush="#FFD0D4DA"
                                    BorderThickness="1"
                                    Padding="8"
                                    CornerRadius="5">
                                <StackPanel>
                                    <TextBlock x:Name="HoverXText" FontWeight="SemiBold"/>
                                    <ItemsControl x:Name="HoverValuesList" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Canvas>

                        <Border x:Name="AnalysisResultsPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="#F2FFFFFF"
                                BorderBrush="#FFD0D4DA"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Numerical analysis" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AnalysisResultsText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="390"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SurfaceProbePanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Background="#F2FFFFFF"
                                BorderBrush="#FFD0D4DA"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="Probe" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SurfaceProbeText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="310"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CrossSectionPreview"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Width="300"
                                Height="185"
                                Background="#F2FFFFFF"
                                BorderBrush="#FFD0D4DA"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="7"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CrossSectionTitleText" Text="Cross-section" FontWeight="SemiBold" FontSize="11"/>
                                <Canvas x:Name="CrossSectionCanvas" Grid.Row="1" Width="282" Height="145" Margin="0,5,0,0" Background="#FFFBFCFE"/>
                            </Grid>
                        </Border>

                        <Border x:Name="SurfaceLegend"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="10"
                                Background="#EFFFFFFF"
                                BorderBrush="#FFD0D4DA"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8"
                                IsHitTestVisible="False">
                            <StackPanel>
                                <TextBlock Text="3D: z=f(x,y), curve3(...), surface(...) and implicit3(...)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock FontSize="11">
                                    <Run Text="x" Foreground="#FFBE4A4A" FontWeight="SemiBold"/>
                                    <Run Text=" axis  ·  "/>
                                    <Run Text="y" Foreground="#FF439162" FontWeight="SemiBold"/>
                                    <Run Text=" axis  ·  "/>
                                    <Run Text="z" Foreground="#FF496FB2" FontWeight="SemiBold"/>
                                    <Run Text=" axis"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>


                        <Grid x:Name="EconomyWorkspacePanel" Grid.RowSpan="5" Background="White" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="1.15*"/></Grid.RowDefinitions>
                            <Border Background="#FFF8F9FB" BorderBrush="#FFE3E6EA" BorderThickness="1" CornerRadius="5" Padding="8" Margin="2,0,2,8">
                                <DockPanel>
                                    <TextBlock Text="Economy simulation" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource ToolbarButton}" Content="▶" Click="EconomyPlayButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Ⅱ" Click="EconomyPauseButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Step" Click="EconomyStepButton_Click"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Reset" Click="EconomyResetButton_Click"/>
                                        <Button x:Name="EconomyReplayToggleButton" Style="{StaticResource ToolbarButton}" Content="Replay" Click="EconomyReplayToggleButton_Click"/>
                                        <Slider x:Name="EconomyReplaySlider" Width="120" Margin="5,0" IsEnabled="False" ValueChanged="EconomyReplaySlider_ValueChanged"/>
                                        <Button Style="{StaticResource ToolbarButton}" Content="Export CSV" Click="EconomyExportCsvButton_Click"/>
                                        <TextBlock Text="dt" Margin="10,0,4,0" VerticalAlignment="Center" Foreground="#FF6B7280"/>
                                        <TextBox x:Name="EconomyDtTextBox" Width="52" Text="0.1" Padding="3,2"/>
                                        <TextBlock Text="speed" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="#FF6B7280"/>
                                        <TextBox x:Name="EconomySpeedTextBox" Width="52" Text="1" Padding="3,2"/>
                                        <TextBlock Text="seed" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="#FF6B7280"/>
                                        <TextBox x:Name="EconomySeedTextBox" Width="66" Text="1337" Padding="3,2"/>
                                        <TextBlock x:Name="EconomyTimeText" Text="t = 0.00" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Canvas x:Name="EconomyCanvas" Background="#FFFBFCFE" ClipToBounds="True" SizeChanged="EconomyCanvas_SizeChanged" MouseLeftButtonDown="EconomyCanvas_MouseLeftButtonDown"/>
                                <Border x:Name="EconomyResourceLegendBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="7" Background="#EEFFFFFF" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="10.5" Margin="0,0,0,3"/>
                                        <StackPanel x:Name="EconomyResourceLegendPanel"/>
                                        <TextBlock Text="Line colour = resource · moving packets = accepted transfers" Foreground="#FF7A818C" FontSize="9.5" Margin="0,4,0,0"/>
                                        <TextBlock Text="◆ conversion · dashed = delayed · arrow/chevron = direction" Foreground="#FF7A818C" FontSize="9.2" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8" Background="#EEFFFFFF" BorderBrush="#FFD0D4DA" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False">
                                    <TextBlock x:Name="EconomyDiagnosticsText" Text="Add nodes or load an example to begin." FontSize="11" TextWrapping="Wrap" MaxWidth="420"/>
                                </Border>
                            </Grid>
                            <TabControl Grid.Row="2" Margin="0,8,0,0">
                                <TabItem Header="History">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock Text="Resource history" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <WrapPanel DockPanel.Dock="Right">
                                                <TextBlock Text="window (s)" VerticalAlignment="Center" Foreground="#FF6B7280"/>
                                                <TextBox x:Name="EconomyHistoryWindowTextBox" Width="58" Text="30" Margin="4,0,8,0" Padding="3,2" TextChanged="EconomyHistoryDisplayTextChanged" ToolTip="Seconds of recent history to show. Use 0 for all recorded history."/>
                                                <TextBlock Text="Y max" VerticalAlignment="Center" Foreground="#FF6B7280"/>
                                                <TextBox x:Name="EconomyHistoryYMaxTextBox" Width="58" Text="auto" Margin="4,0,8,0" Padding="3,2" TextChanged="EconomyHistoryDisplayTextChanged" ToolTip="Type a positive number for a fixed Y scale, or 'auto'."/>
                                                <CheckBox x:Name="EconomyHistoryCapacityCheckBox" Content="Capacities" IsChecked="False" Margin="2,0,8,0" VerticalAlignment="Center" Click="EconomyHistoryDisplayChanged" ToolTip="Show storage capacity guides."/>
                                                <Button Content="All" Padding="6,2" Margin="2,0" Click="EconomyHistorySeriesAllButton_Click"/>
                                                <Button Content="None" Padding="6,2" Margin="2,0" Click="EconomyHistorySeriesNoneButton_Click"/>
                                            </WrapPanel>
                                        </DockPanel>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="54" Margin="0,5,0,0">
                                            <WrapPanel x:Name="EconomyHistorySeriesPanel"/>
                                        </ScrollViewer>
                                        <Canvas x:Name="EconomyChartCanvas" Grid.Row="2" Background="#FFFBFCFE" Margin="0,5,0,0" SizeChanged="EconomyChartCanvas_SizeChanged"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Predictions">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel>
                                            <TextBlock Text="runs" VerticalAlignment="Center"/><TextBox x:Name="EconomyPredictionRunsTextBox" Width="58" Text="500" Margin="4,0,8,0" Padding="3,2"/>
                                            <TextBlock Text="horizon" VerticalAlignment="Center"/><TextBox x:Name="EconomyPredictionHorizonTextBox" Width="60" Text="30" Margin="4,0,8,0" Padding="3,2"/>
                                            <CheckBox x:Name="EconomyPopulationMixCheckBox" Content="Population mix" Margin="4,0,8,0" VerticalAlignment="Center" ToolTip="Choose cohorts according to their weights on each run"/>
                                            <Button x:Name="EconomyRunPredictionButton" Content="Run prediction" Padding="8,3" Click="EconomyRunPredictionButton_Click"/>
                                            <Button x:Name="EconomyCancelPredictionButton" Content="Cancel" Padding="8,3" Margin="4,0,0,0" Click="EconomyCancelPredictionButton_Click" IsEnabled="False"/>
                                        </WrapPanel>
                                        <TextBox x:Name="EconomyPredictionResultsTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Debugger">
                                    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel><Button Content="Break on selected flow" Padding="7,2" Click="EconomyBreakpointButton_Click"/><TextBlock x:Name="EconomyBreakpointText" Text="No breakpoint" Margin="8,0" VerticalAlignment="Center" Foreground="#FF6B7280"/><Button Content="Clear log" Padding="7,2" Click="EconomyClearDebuggerButton_Click"/></WrapPanel>
                                        <ListBox x:Name="EconomyDebuggerListBox" Grid.Row="1" Margin="0,6,0,0" FontFamily="Consolas" FontSize="10"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,1"><TextBlock TextWrapping="Wrap"><Run Text="{Binding Time, StringFormat=t={0:0.###}  }"/><Run Text="{Binding Flow}"/><Run Text="{Binding Reason, StringFormat=  · {0}}"/></TextBlock><TextBlock Text="{Binding Detail}" Foreground="#FF6B7280" FontSize="9" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Sensitivity">
                                    <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button x:Name="EconomySensitivityButton" Content="Analyse selected target" Padding="8,3" Click="EconomySensitivityButton_Click"/><TextBlock Text="Perturbs each free parameter by 5% of its range using a common seed." Margin="8,0" VerticalAlignment="Center" Foreground="#FF6B7280"/></WrapPanel><TextBox x:Name="EconomySensitivityTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Grid>
                                </TabItem>
                                <TabItem Header="Balance search">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <WrapPanel>
                                            <TextBlock Text="Target" VerticalAlignment="Center"/><ComboBox x:Name="EconomyTargetNodeComboBox" Width="135" Margin="4,0" DisplayMemberPath="Name"/>
                                            <TextBlock Text="min" VerticalAlignment="Center"/><TextBox x:Name="EconomyTargetMinTextBox" Width="58" Text="0" Margin="4,0" Padding="3,2"/>
                                            <TextBlock Text="max" VerticalAlignment="Center"/><TextBox x:Name="EconomyTargetMaxTextBox" Width="58" Text="100" Margin="4,0" Padding="3,2"/>
                                            <Button Content="Add target" Padding="7,2" Margin="4,0" Click="EconomyAddTargetButton_Click"/>
                                            <Button Content="Remove" Padding="7,2" Click="EconomyDeleteTargetButton_Click"/>
                                        </WrapPanel>
                                        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                                            <ListBox x:Name="EconomyTargetsListBox" Width="280" Height="54" ItemsSource="{Binding EconomyTargets}" DisplayMemberPath="Display"/>
                                            <StackPanel Margin="8,0,0,0"><WrapPanel><TextBlock Text="candidates" VerticalAlignment="Center"/><TextBox x:Name="EconomyOptimizationCandidatesTextBox" Width="58" Text="300" Margin="4,0" Padding="3,2"/><Button x:Name="EconomyOptimizationSearchButton" Content="Search" Padding="8,2" Click="EconomyOptimizeButton_Click"/><Button x:Name="EconomyCancelOptimizationButton" Content="Cancel" Padding="8,2" Margin="4,0,0,0" Click="EconomyCancelOptimizationButton_Click" IsEnabled="False"/><Button x:Name="EconomyApplyOptimizationButton" Content="Apply best" Padding="8,2" Margin="4,0,0,0" Click="EconomyApplyOptimizationButton_Click" IsEnabled="False"/></WrapPanel><TextBlock Text="Searches parameter min/max ranges; selected scenario/cohort overrides stay fixed." FontSize="10" Foreground="#FF7A818C" Margin="0,3,0,0"/></StackPanel>
                                        </WrapPanel>
                                        <TextBox x:Name="EconomyOptimizationResultsTextBox" Grid.Row="2" Margin="0,6,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#FFE1E3E7" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="ViewRangeText" Foreground="#FF6B7280"/>
                <TextBlock x:Name="FooterHintText"
                           DockPanel.Dock="Right"
                           Foreground="#FF8A9099"
                           Text="Enter refreshes immediately · Esc clears the active expression"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
